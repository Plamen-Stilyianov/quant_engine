# ==============================================================================
# STAGE 1: THE COMPILATION WHEEL BUILDER (Temporary Builder Environment)
# ==============================================================================
FROM python:3.13-slim AS package-builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        make \
        libc6-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip setuptools wheel

COPY requirements.txt .
RUN pip wheel --no-cache-dir --wheel-dir /build/wheels -r requirements.txt

# ==============================================================================
# STAGE 2: THE SECURE DEPLOYMENT RUNNER (Final Slim Production Image)
# ==============================================================================
FROM python:3.13-slim AS production-runner

WORKDIR /app

RUN pip install --no-cache-dir --upgrade pip

COPY --from=package-builder /build/wheels /app/wheels

# Safe multi-arch shell execution loop to extract wheels seamlessly
RUN for whl in /app/wheels/*.whl; do pip install --no-cache-dir --no-index --find-links=/app/wheels "$whl"; done \
    && rm -rf /app/wheels

# Copy application data directly
COPY . .
RUN mkdir -p /app/logs

ENV PYTHONUNBUFFERED=1

CMD ["streamlit", "run", "webgui_dashboard/main_ui.py", "--server.port=8501", "--server.address=0.0.0.0"]
